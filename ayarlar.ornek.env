# kur.sh bu dosyayı .env olarak otomatik doldurur. Elle kuruyorsan kopyalayıp düzenle.

# Sunucunun alan adı. Alan adın yoksa sslip.io kullanılır: IP 1.2.3.4 ise 1-2-3-4.sslip.io
DOMAIN=1-2-3-4.sslip.io

# LiveKit anahtarları (rastgele, uzun)
LIVEKIT_API_KEY=APIdegistir
LIVEKIT_API_SECRET=en-az-32-karakterlik-rastgele-bir-gizli-anahtar

# Test sayfasının şifresi
TEST_SIFRESI=degistir

# Dil modeli. 24 GB GPU: Qwen/Qwen3-8B-AWQ  |  48 GB GPU: Qwen/Qwen3-14B-AWQ
LLM_MODEL=Qwen/Qwen3-8B-AWQ
# vLLM'nin ayıracağı GPU belleği oranı (kalan kısım Whisper ve TTS için)
LLM_GPU_ORANI=0.55

# Whisper modeli
STT_MODEL=large-v3-turbo

# Ayla'nın acil durumlarda söyleyeceği numara
KLINIK_ACIL_TELEFON="0 212 000 00 00"
